                "@odata.etag": "W/\"21457376\"",
                "rsmhhs_like_and_admire": "\u2022\tJohn is easy to talk to; he listens and often offers thoughtful advice or an interesting perspective.\n\u2022\tJohn enjoys creative projects such as pottery and artwork.\n\u2022\tJohn values punctuality and helps others plan travel time so everyone arrives on time.\n\u2022\tHe is strong with computers and troubleshooting technology.\n\u2022\tJohn enjoys reading and likes discussing books and ideas with others.",
                "modifiedon": "2026-05-04T17:45:39Z",
                "_rsmhhs_customerid_value": "d5dcccd8-6745-f111-88b4-001dd801f94a",
                "_owninguser_value": "42070020-dff6-f011-8407-001dd80c29f4",
                "overriddencreatedon": null,
                "rsmhhs_how_to_best_support": "\u2022\tGive John time to process questions and respond; use clear, literal language.\n\u2022\tOffer written directions for multi-step tasks and keep instructions organized.\n\u2022\tAllow John to try tasks his own way first when it is safe.\n\u2022\tJohn has seizures that can occur multiple times a day; follow his seizure protocol and avoid drawing attention unless safety requires it.",
                "importsequencenumber": null,
                "rsmhhs_profile_type": 592570001,
                "_modifiedonbehalfby_value": "42070020-dff6-f011-8407-001dd80c29f4",
                "statecode": 0,
                "versionnumber": 21457376,
                "utcconversiontimezonecode": null,
                "rsmhhs_important_to_this_person": "\u2022\tHaving access to his own computer and reliable internet.\n\u2022\tBeing on time and understanding schedules in advance.\n\u2022\tLearning something new regularly and solving problems independently when safe.\n\u2022\tBeing around people who enjoy conversation, especially when he is not focusing on a task.\n\u2022\tKnowing ingredients in meals due to allergies and sensitivities.\n\u2022\tStaying indoors during extreme heat, heavy rain, or unsafe weather.",
                "_rsmhhs_serviceplanid_value": "4ed07408-e147-f111-88b4-001dd801f94a",
                "_createdonbehalfby_value": "42070020-dff6-f011-8407-001dd80c29f4",
